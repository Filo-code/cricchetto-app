Criccheto_SUPABASE_URL=https://your-project.supabase.co
Criccheto_SUPABASE_SERVICE_ROLE_KEY=replace-me

Criccheto_INTERNAL_API_SECRET=replace-me

# REQUIRED in production. Used by n8n → backend internal endpoints only.
# Must be separate from DASHBOARD_API_SECRET — no cross-secret fallback in production.
# Criccheto_INTERNAL_API_SECRET is NOT valid for x-dashboard-secret in production.

# REQUIRED in production. Authenticates dashboard API calls (x-dashboard-secret header).
# Must be distinct from INTERNAL_API_SECRET.
Criccheto_DASHBOARD_API_SECRET=replace-me

# REQUIRED in production. Used to sign dashboard session cookies (HMAC-SHA256).
# Must be distinct from DASHBOARD_API_SECRET and INTERNAL_API_SECRET.
# Missing in production = server throws on first login attempt.
Criccheto_DASHBOARD_SESSION_SECRET=replace-me

Criccheto_BACKEND_BASE_URL=https://cricchetto.filo-ai.it
Criccheto_DASHBOARD_USERNAME=admin
Criccheto_DASHBOARD_PASSWORD=replace-me

# REQUIRED in production: pin the dashboard to a specific workshop by ID.
# Without this, the server throws rather than falling back to first-by-date (multi-tenant safety).
Criccheto_DASHBOARD_WORKSHOP_ID=replace-me

# Comma-separated emails allowed to access /admin/* (Filò platform owner only).
# workshop_users.role='owner' means client-workshop owner — NOT platform owner.
# Leave empty to block all admin access.
Criccheto_PLATFORM_OWNER_EMAILS=platform-owner@example.com

# Optional. Protects the internal/default platform workshop from suspend/close actions.
Criccheto_PLATFORM_WORKSHOP_ID=replace-me-optional

Criccheto_N8N_DISPATCH_SECRET=replace-me
Criccheto_N8N_PUBLIC_BASE_URL=https://n8n.filo-ai.it

Criccheto_TELEGRAM_BOT_TOKEN=replace-me
Criccheto_TELEGRAM_WEBHOOK_SECRET=replace-me
Criccheto_TELEGRAM_BOT_IDENTIFIER=Cricchetto_bot

Criccheto_DOCUMENTS_BUCKET=documents
Criccheto_ATTACHMENTS_BUCKET=attachments
Criccheto_BRANDING_BUCKET=workshop-branding
Criccheto_DOCUMENT_TEMPLATES_BUCKET=document-templates

Criccheto_WHATSAPP_PROVIDER=meta_whatsapp_cloud_api
Criccheto_WHATSAPP_GRAPH_API_BASE_URL=https://graph.facebook.com/v20.0
Criccheto_WHATSAPP_ACCESS_TOKEN=replace-me
Criccheto_WHATSAPP_APP_SECRET=replace-me
Criccheto_WHATSAPP_VERIFY_TOKEN=replace-me
Criccheto_WHATSAPP_PHONE_NUMBER_ID=replace-me

# Optional: public WhatsApp support number shown on /login.
# Format: international digits only, e.g. 393331234567. Leave empty to hide the button.
Criccheto_SUPPORT_WHATSAPP_NUMBER=

# Optional: SMTP for autonomous password reset emails (/forgot-password).
# If not set, the reset link is only logged to server console (dev) and email is not sent.
Criccheto_SMTP_HOST=
Criccheto_SMTP_PORT=587
Criccheto_SMTP_USER=
Criccheto_SMTP_PASS=
Criccheto_MAIL_FROM=
