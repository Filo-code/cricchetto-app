# Supabase (multi-tenant database backend)
Cricchetto_SUPABASE_URL=https://your-project.supabase.co
Cricchetto_SUPABASE_SERVICE_ROLE_KEY=replace-me

# Authentication Secrets (CRITICAL: generate unique values for production)
# Use: openssl rand -hex 64
Cricchetto_INTERNAL_API_SECRET=replace-me
Cricchetto_DASHBOARD_API_SECRET=replace-me
Cricchetto_DASHBOARD_SESSION_SECRET=replace-me

# Dashboard Configuration
Cricchetto_BACKEND_BASE_URL=https://your-domain.com
Cricchetto_DASHBOARD_USERNAME=admin
Cricchetto_DASHBOARD_PASSWORD=replace-me

# Multi-tenant Configuration (REQUIRED in production for safety)
# Cricchetto_DASHBOARD_WORKSHOP_ID: locks dashboard to specific workshop (prevents fallback)
# Without this in production, server throws error rather than defaulting to first workshop
Cricchetto_DASHBOARD_WORKSHOP_ID=replace-me

# Platform Admin (comma-separated emails for /admin/* access)
# Note: workshop_users.role='owner' is client-workshop owner, NOT platform owner
Cricchetto_PLATFORM_OWNER_EMAILS=platform-owner@example.com

# Optional: Internal platform workshop ID (protects from suspend/close via API)
Cricchetto_PLATFORM_WORKSHOP_ID=replace-me-optional

# N8N Workflows Backend
Cricchetto_N8N_PUBLIC_BASE_URL=https://n8n.your-domain.com
Cricchetto_N8N_DISPATCH_SECRET=replace-me

# Telegram (Multi-tenant Channel)
# Get bot token from BotFather (@BotFather on Telegram)
# Webhook secret: use openssl rand -hex 64
Cricchetto_TELEGRAM_BOT_TOKEN=replace-me
Cricchetto_TELEGRAM_WEBHOOK_SECRET=replace-me
Cricchetto_TELEGRAM_BOT_IDENTIFIER=Cricchetto_bot

# WhatsApp — Meta CloudAPI (global account, credentials from Meta Business Platform)
Cricchetto_WHATSAPP_ACCESS_TOKEN=replace-me
Cricchetto_WHATSAPP_APP_SECRET=replace-me
Cricchetto_WHATSAPP_VERIFY_TOKEN=replace-me
Cricchetto_WHATSAPP_PHONE_NUMBER_ID=replace-me
Cricchetto_WHATSAPP_GRAPH_API_BASE_URL=https://graph.facebook.com/v20.0

# WhatsApp — Twilio (global account, per-workshop from_number stored in workshop_channels.provider_config)
# Get from: console.twilio.com → Account → API Credentials
Cricchetto_TWILIO_ACCOUNT_SID=replace-me
Cricchetto_TWILIO_AUTH_TOKEN=replace-me

# Optional: WhatsApp support number on /login (international format, no +)
Cricchetto_SUPPORT_WHATSAPP_NUMBER=

# Storage Buckets (Supabase)
Cricchetto_DOCUMENTS_BUCKET=documents
Cricchetto_ATTACHMENTS_BUCKET=attachments
Cricchetto_BRANDING_BUCKET=workshop-branding
Cricchetto_DOCUMENT_TEMPLATES_BUCKET=document-templates

# Optional: SMTP for password reset emails (/forgot-password)
# If not set, reset link only logged to console (dev mode)
Cricchetto_SMTP_HOST=
Cricchetto_SMTP_PORT=587
Cricchetto_SMTP_USER=
Cricchetto_SMTP_PASS=
Cricchetto_MAIL_FROM=
