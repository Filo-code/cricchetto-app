{
  "name": "WF-08 Outbound Recovery Scheduler",
  "nodes": [
    {
      "parameters": {
        "rule": {
          "interval": [
            {
              "field": "minutes",
              "minutesInterval": 10
            }
          ]
        }
      },
      "id": "0e20f571-4df0-4f1f-8c69-b87bcf2ff6eb",
      "name": "10 Minute Schedule",
      "type": "n8n-nodes-base.scheduleTrigger",
      "typeVersion": 1,
      "position": [
        0,
        0
      ]
    },
    {
      "parameters": {
        "method": "POST",
        "url": "={{$env.Criccheto_BACKEND_BASE_URL}}/api/internal/outbound/recover-stuck",
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [
            {
              "name": "x-internal-secret",
              "value": "={{$env.Criccheto_INTERNAL_API_SECRET}}"
            }
          ]
        },
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={{ JSON.stringify({ limit: 20 }) }}",
        "options": {}
      },
      "id": "2f3d6e56-194e-4bd1-9721-43176525d908",
      "name": "Recover Stuck Outbound",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4,
      "position": [
        240,
        0
      ]
    },
    {
      "parameters": {
        "jsCode": "const queued = $json.queued || [];\nif (!Array.isArray(queued)) throw new Error('Backend outbound/recover-stuck response must include queued array');\nconsole.log('[WF-08] outbound recovery batch', { scanned: $json.scanned ?? '?', recovered: queued.length, failed: $json.failed ?? '?', remindersRecovered: $json.remindersRecovered ?? '?' });\nreturn queued.map((item) => {\n  for (const field of ['messageLogId', 'channel', 'provider', 'recipientIdentifier', 'text']) {\n    if (!item[field]) throw new Error(`Recovered outbound message missing ${field}`);\n  }\n  return { json: item };\n});"
      },
      "id": "b81c1d14-8566-44b0-b197-c7bc6a4b0e43",
      "name": "Extract Recovered Messages",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        480,
        0
      ]
    },
    {
      "parameters": {
        "method": "POST",
        "url": "={{$env.Criccheto_N8N_PUBLIC_BASE_URL}}/webhook/mechanic/outbound-dispatch",
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [
            {
              "name": "x-dispatch-secret",
              "value": "={{$env.Criccheto_N8N_DISPATCH_SECRET}}"
            }
          ]
        },
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={{ JSON.stringify({\n  messageLogId: String($json.messageLogId),\n  channel: $json.channel,\n  provider: $json.provider,\n  senderIdentifier: $json.senderIdentifier ? String($json.senderIdentifier) : undefined,\n  recipientIdentifier: String($json.recipientIdentifier),\n  text: String($json.text || ''),\n  relatedWorkOrderId: $json.relatedWorkOrderId,\n  relatedReminderId: $json.relatedReminderId,\n  relatedDocumentId: $json.relatedDocumentId\n}) }}",
        "options": {}
      },
      "id": "c163539c-00eb-4b8c-8a28-7d9f8f095e68",
      "name": "Dispatch Recovered Outbound",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4,
      "position": [
        720,
        0
      ]
    }
  ],
  "pinData": {},
  "connections": {
    "10 Minute Schedule": {
      "main": [
        [
          {
            "node": "Recover Stuck Outbound",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Recover Stuck Outbound": {
      "main": [
        [
          {
            "node": "Extract Recovered Messages",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Extract Recovered Messages": {
      "main": [
        [
          {
            "node": "Dispatch Recovered Outbound",
            "type": "main",
            "index": 0
          }
        ]
      ]
    }
  },
  "active": false,
  "settings": {
    "executionOrder": "v1",
    "binaryMode": "separate"
  },
